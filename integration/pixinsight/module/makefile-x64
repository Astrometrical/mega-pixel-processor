######################################################################
# Mega Pixel Processor PixInsight module (BigTIFF-pxm)
#   Linux/g++/x64 + macOS/clang++/arm64
#
# Modeled on MergeMosaic's integration/pixinsight/module/makefile-x64 (our
# code). The module links libPCL-pxi.a plus the PCL-free host/ objects
# (mpp_shm / mpp_protocol / mpp_host), compiled here into the module link so
# the .so carries no undefined mpp:: symbols (gated by
# `nm -D -u BigTIFF-pxm.so`). Do NOT add -Wl,--no-undefined (Linux) or
# otherwise strip undefined symbols: the module's low-level PixInsight-core
# symbols are resolved by the core at load time, so undefined core symbols
# in the module are expected and correct.
#
# Divergences from MMM's makefile (deliberate):
#   * -std=c++20, same as MMM: the plan's global constraint says C++17, but
#     PCL 2.10.4's Image.h does not compile as C++17 (pcl::Complex<float>
#     comparisons in its clip/truncate code resolve only under C++20 rules),
#     verified empirically here. Our own module + host sources stay
#     C++17-clean (the host lib is built and gated as C++17 by its CMake
#     suite); this makefile merely compiles them in c++20 mode to satisfy
#     the PCL headers.
#   * -Wall -Wextra with PCL headers included via -isystem: the plan gates
#     this build on ZERO -Wall -Wextra warnings for OUR code; -isystem keeps
#     third-party PCL headers from failing that gate while every module/host
#     translation unit stays fully warning-checked. (MMM instead used plain
#     -I with -Wno-parentheses.)
######################################################################

PCLINCDIR ?= /opt/PixInsight/include
PCLLIBDIR ?= $(HOME)/.local/pcl-build/lib
HOSTDIR    = ../host

OBJDIR   = x64/Release

# Platform switch. NOTE on CXX: GNU Make ships a built-in default of CXX=g++
# (origin "default"), and `?=` only assigns when a variable is *undefined* --
# a built-in default counts as already-defined, so plain `CXX ?= clang++`
# would silently never take effect on Darwin. Guard on `$(origin CXX)` so a
# real user/environment override (`make CXX=...`) still wins, but the
# make-supplied default doesn't block the platform choice.
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
  ifeq ($(origin CXX),default)
    CXX := clang++
  endif
  MODULE_EXT := dylib
  SHARED_FLAGS := -dynamiclib -install_name @rpath/BigTIFF-pxm.dylib
  # See MMM's makefile for the full rationale: the Linux branch's
  # -D__PCL_AVX2/-D__PCL_FMA/-mavx2/-mfma/-m64/-minline-all-stringops are
  # GCC-only x86 flags and -fnon-call-exceptions is a GCC extension, so the
  # Darwin branch uses PCL's Apple flags instead. macOS has no librt
  # (shm_open etc. are in libc). Apple's linker is strict about undefined
  # symbols in a .dylib: libPCL-pxi.a pulls in AppKit + PCL's vendored
  # 3rdparty static libs transitively; -lPCL-pxi must precede the 3rdparty
  # libs it depends on.
  PLATFORM_CXXFLAGS := -arch arm64 -mmacosx-version-min=14 -stdlib=libc++ \
                        -D__PCL_MACOSX
  PLATFORM_LIBS := -framework AppKit -lpthread -lPCL-pxi \
                    -llz4-pxi -lzstd-pxi -lzlib-pxi -lRFC6234-pxi \
                    -llcms-pxi -lcminpack-pxi
else
  ifeq ($(origin CXX),default)
    CXX := g++
  endif
  MODULE_EXT := so
  SHARED_FLAGS := -shared
  PLATFORM_CXXFLAGS := -m64 -D__PCL_LINUX -D__PCL_AVX2 -D__PCL_FMA \
                        -mavx2 -mfma -fnon-call-exceptions -minline-all-stringops
  PLATFORM_LIBS := -lPCL-pxi -lpthread -lrt
endif

TARGET   = BigTIFF-pxm.$(MODULE_EXT)

# PCL headers are third-party: -isystem (see header comment). The host lib
# and its vendored json.hpp are ours/vendored; json.hpp is only included by
# host sources already gated warning-free by the host CTest build.
INCLUDES = -isystem "$(PCLINCDIR)" -I"$(HOSTDIR)" -I"$(HOSTDIR)/third_party"

CXXFLAGS = -c -pipe -pthread -fPIC \
           -D_REENTRANT $(PLATFORM_CXXFLAGS) \
           -O3 -ffunction-sections -fdata-sections \
           -fvisibility=hidden -fvisibility-inlines-hidden \
           -std=c++20 -Wall -Wextra

LDFLAGS  = $(SHARED_FLAGS) -fPIC
LIBS     = -L"$(PCLLIBDIR)" $(PLATFORM_LIBS)

MODULE_OBJS = $(OBJDIR)/Mpp.o \
              $(OBJDIR)/BigTiffFormat.o \
              $(OBJDIR)/BigTiffInstance.o

HOST_OBJS   = $(OBJDIR)/mpp_shm.o \
              $(OBJDIR)/mpp_protocol.o \
              $(OBJDIR)/mpp_host.o

OBJS = $(MODULE_OBJS) $(HOST_OBJS)

.PHONY: all
all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(LDFLAGS) -o $(TARGET) $(OBJS) $(LIBS)

# --- Code signing (PixInsight >= 1.9 refuses unsigned modules) ---------------
# For LOCAL development generate a local signing identity once via the
# bundled SigningKeys script (writes a .xssk keys file tied to your license),
# then:
#
#   make sign XSSK_FILE=$HOME/mpp-dev.xssk XSSK_PASSWORD='your-password'
#
# That produces BigTIFF-pxm.xsgn beside the module, which the local core
# trusts. A Pleiades Certified-Developer cert is only needed to distribute
# to OTHER machines. (Same procedure as MergeMosaic's module.)
PIXINSIGHT    ?= PixInsight
XSSK_FILE     ?=
XSSK_PASSWORD ?=
SIGN_EXIT     ?= --force-exit

.PHONY: sign
sign: $(TARGET)
	@test -n "$(XSSK_FILE)" || { \
	  echo "error: set XSSK_FILE=/path/to/your.xssk (generate it via the PixInsight"; \
	  echo "       SigningKeys script with 'Local signing identity' ticked)."; \
	  exit 1; }
	$(PIXINSIGHT) --automation-mode -n \
	  --sign-module-file="$(CURDIR)/$(TARGET)" \
	  --xssk-file="$(XSSK_FILE)" --xssk-password="$(XSSK_PASSWORD)" \
	  $(SIGN_EXIT)
	@test -f "$(CURDIR)/BigTIFF-pxm.xsgn" \
	  && echo "signed: BigTIFF-pxm.xsgn written beside the module" \
	  || echo "note: BigTIFF-pxm.xsgn not found — check the signing output above (flags/password)."

# Module sources (this directory).
$(OBJDIR)/%.o: %.cpp | $(OBJDIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -o $@ $<

# Host library sources (../host), compiled into the module link.
$(OBJDIR)/%.o: $(HOSTDIR)/%.cpp | $(OBJDIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -o $@ $<

$(OBJDIR):
	mkdir -p $(OBJDIR)

.PHONY: clean
clean:
	rm -f $(OBJS) $(TARGET)
	rm -rf $(OBJDIR)
