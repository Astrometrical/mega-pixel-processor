# Pinned open-source PCL revision for CI module builds.
# Single source of truth; sourced by the build-pcl*.{sh,ps1} scripts and by
# .github/workflows/module.yml (cache key).
#
# Adapted from MergeMosaic's integration/pixinsight/ci/pcl-pin.env. The
# PCL_REPO_URL + PCL_SHA values below are copied verbatim from MergeMosaic's
# original "2.10.4/Lockhart" pin (MergeMosaic
# docs/superpowers/plans/2026-07-28-pixinsight-ci-and-distribution.md, Task 1
# Step 1) -- this is the exact PCL revision already built locally at
# ~/.local/pcl-build (see integration/pixinsight/module/makefile-x64's
# PCLLIBDIR default) and gated against in Task 4's module build.
#
# Note: MergeMosaic's *current* ci/pcl-pin.env has since moved to a
# different, older pin (PCL 2.8.3) chosen for its own oldest-supported-core
# compatibility policy across a wider PixInsight install base. mpp
# deliberately keeps the 2.10.4 pin instead, matching the PixInsight core
# actually installed on this dev machine (1.9.4 "Lockhart") and the PCL
# headers/library Task 4 already built and gated the module against, rather
# than adopting MergeMosaic's broader-compatibility policy.
#
# gitlab.com/pixinsight/PCL @ this SHA == PCL 2.10.4 / PixInsight 1.9.4 "Lockhart".
PCL_REPO_URL="https://gitlab.com/pixinsight/PCL.git"
PCL_SHA="afea714e681853dfc21e70b5d53811ae41849e97"
PCL_VER_MAJOR=2
PCL_VER_MINOR=10
PCL_VER_RELEASE=4

# Expected `#define PCL_API_Version 0x<hex>` in include/pcl/api/APIInterface.h
# at PCL_SHA. PCL_API_Version becomes the module's declared API requirement;
# a core older than it refuses to load the module, so a pin bump that raises
# this silently drops support for older PixInsight versions -- the
# build-pcl*.{sh,ps1} scripts fail hard on mismatch against the pinned
# checkout's own header, and build-module-*.{sh,ps1} independently re-verify
# it against whatever PCLINCDIR is actually being linked against (covers the
# prebuilt-PCL path too, where build-pcl* never runs).
#
# Provenance: verified empirically, 2026-08-22, against
# /opt/PixInsight/include/pcl/api/APIInterface.h:59 on this dev machine's
# actual PixInsight 1.9.4 "Lockhart" install (the install this pin targets)
# -- NOT copied from MergeMosaic's own pcl-pin.env comment table, which
# guesses 0x0187 for PCL 2.10.x and was empirically wrong for this install.
PCL_API_VERSION_HEX=0186

# Compatibility policy: supported floor is PixInsight >= 1.9.4 (this pin's
# PCL_API_Version 0x0186; older cores are untested and unsupported by mpp v1).
