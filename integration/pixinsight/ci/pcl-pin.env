# Pinned open-source PCL revisions for CI module builds.
# Single source of truth; sourced by the build-pcl*.{sh,ps1} scripts and by
# .github/workflows/module.yml (cache keys). Keep in sync with the OLDEST
# supported PixInsight core (per target arch -- see the arm64 exception).
#
# Adapted from MergeMosaic's integration/pixinsight/ci/pcl-pin.env (the file
# format, the oldest-supported-core pinning POLICY, and the per-arch macOS
# pin split are MMM's -- adopted here after MMM's 1.9.3 field report proved
# the failure mode live: "Unsupported API version 187 (expected <= 186)").
#
# Compatibility policy: the module supports PixInsight >= 1.9.0. The PCL
# static lib bakes PCL_API_Version into the module as its declared API
# requirement, and a core refuses any module declaring a newer API than its
# own -- so we build against the PCL matching the oldest supported core, and
# newer cores accept it via backward compatibility. The version is not
# overridable: it is PCL's promise about which core API functions its
# resolve table needs (2.10.4's needs six functions absent from pre-1.9.4
# cores). Core API history across 1.9.x (from MMM's pin file):
#   1.9.0 initial (PCL 2.8.3)           -> 0x0182
#   1.9.0 update .. 1.9.3 early (2.8.x) -> 0x0183
#   1.9.3 late (PCL 2.9.x)              -> 0x0186
#   1.9.4 (PCL 2.10.x)                  -> 0x0187
#
# History note (mpp): this file first pinned afea714e (PCL 2.10.4, 0x0187,
# matching the prebuilt lib then at ~/.local/pcl-build), which would have
# locked out every pre-1.9.4 core including a module built for the dev
# machine's own installed 1.9.4-with-2.9.4-SDK layout; it was then briefly
# re-pinned to 2.9.4/0x0186 (floor = 1.9.4) before adopting MMM's wider
# 1.9.0+ policy above.
#
# gitlab.com/pixinsight/PCL @ this SHA == PCL 2.8.3 / PixInsight 1.9.0 (initial).
PCL_REPO_URL="https://gitlab.com/pixinsight/PCL.git"
PCL_SHA="f1f257d9089bc090d30a319c0a66061c4869b9b2"
PCL_VER_MAJOR=2
PCL_VER_MINOR=8
PCL_VER_RELEASE=3

# Expected `#define PCL_API_Version 0x<hex>` in include/pcl/api/APIInterface.h
# at PCL_SHA -- i.e. what the PINNED GIT CHECKOUT declares, which is what the
# module actually links against and declares as its own API requirement. A
# core older than that value refuses to load the module, so a pin bump that
# raises it silently drops support for older PixInsight versions -- the
# build-pcl*.{sh,ps1} scripts fail hard on mismatch against the pinned
# checkout's own header, and build-module-*.{sh,ps1} re-verify whatever
# PCLINCDIR is actually being linked against (covers the prebuilt-PCL path
# too, where build-pcl* never runs).
PCL_API_VERSION_HEX=0182

# macOS-arm64-only pin: PCL 2.10.4 / PixInsight 1.9.4 "Lockhart". Pre-2.10.3
# PCL cannot compile for arm64 AT ALL (Defs.h hard-errors on non-x86 and
# Atomic.h/Math.h use x86 inline asm unconditionally) -- arm64 support
# arrived with the first arm64 core, 1.9.4. That also makes API 0x0187
# correct for this target: every arm64 macOS core is >= 1.9.4, so 0x0187
# excludes nobody on that arch. All other targets (linux-x64, windows-x64,
# macos-x64) use the 2.8.3 pin above; 1.9.0-1.9.3 macOS users run x64 cores
# (Rosetta on Apple Silicon) and are served by the macos-x64 package.
PCL_ARM64_SHA="afea714e681853dfc21e70b5d53811ae41849e97"
PCL_ARM64_VER_MAJOR=2
PCL_ARM64_VER_MINOR=10
PCL_ARM64_VER_RELEASE=4
PCL_ARM64_API_VERSION_HEX=0187
