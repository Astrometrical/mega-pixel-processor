# Pinned open-source PCL revision for CI module builds.
# Single source of truth; sourced by the build-pcl*.{sh,ps1} scripts and by
# .github/workflows/module.yml (cache key).
#
# Adapted from MergeMosaic's integration/pixinsight/ci/pcl-pin.env. The
# PCL_REPO_URL + PCL_SHA values below are copied verbatim from MergeMosaic's
# original "2.10.4/Lockhart" pin (MergeMosaic
# docs/superpowers/plans/2026-07-28-pixinsight-ci-and-distribution.md, Task 1
# Step 1) -- this is the exact PCL revision already built locally at
# ~/.local/pcl-build (see integration/pixinsight/module/makefile-x64's
# PCLLIBDIR default) and gated against in Task 4's module build.
#
# Note: MergeMosaic's *current* ci/pcl-pin.env has since moved to a
# different, older pin (PCL 2.8.3) chosen for its own oldest-supported-core
# compatibility policy across a wider PixInsight install base. mpp
# deliberately keeps the 2.10.4 pin instead, matching the PixInsight core
# actually installed on this dev machine (1.9.4 "Lockhart") and the PCL
# headers/library Task 4 already built and gated the module against, rather
# than adopting MergeMosaic's broader-compatibility policy.
#
# gitlab.com/pixinsight/PCL @ this SHA == PCL 2.10.4 / PixInsight 1.9.4 "Lockhart".
PCL_REPO_URL="https://gitlab.com/pixinsight/PCL.git"
PCL_SHA="afea714e681853dfc21e70b5d53811ae41849e97"
PCL_VER_MAJOR=2
PCL_VER_MINOR=10
PCL_VER_RELEASE=4

# Expected `#define PCL_API_Version 0x<hex>` in include/pcl/api/APIInterface.h
# at PCL_SHA -- i.e. what the PINNED GIT CHECKOUT declares, which is what the
# module actually links against and declares as its own API requirement. A
# core older than that value refuses to load the module, so a pin bump that
# raises it silently drops support for older PixInsight versions -- the
# build-pcl*.{sh,ps1} scripts fail hard on mismatch against the pinned
# checkout's own header. build-module-*.{sh,ps1} separately re-verify
# whatever PCLINCDIR is actually being linked against (covers the
# prebuilt-PCL path too, where build-pcl* never runs) -- but that check is
# asymmetric (WARN only if the local value is lower, HARD-FAIL only if
# higher); see those scripts' comments for why.
#
# Provenance: verified 2026-08-22 by fetching the PINNED SHA's header
# directly from GitLab --
# https://gitlab.com/pixinsight/PCL/-/raw/afea714e681853dfc21e70b5d53811ae41849e97/include/pcl/api/APIInterface.h
# -- line 28 reads `#define PCL_API_Version 0x0187`. MergeMosaic's own
# updated pin file (its arm64/2.10.4-era section) independently records
# 0187 for this same SHA, corroborating the direct fetch.
#
# IMPORTANT DIVERGENCE, not an error: this dev machine's *installed*
# PixInsight 1.9.4 app bundles an OLDER copy of the header
# (/opt/PixInsight/include/pcl/api/APIInterface.h:59 reads 0x0186) --
# the app's bundled headers lag the gitlab 2.10.4 tag this SHA points at.
# A prior version of this file wrongly set PCL_API_VERSION_HEX=0186 by
# trusting only the local install and not the pinned checkout itself; that
# was the wrong source for what the module built *from the pin* declares.
# The local module build on this machine is therefore mixed (built against
# /opt's 0186 headers, but linked against a prebuilt libPCL-pxi.a compiled
# from the 2.10.4 source) -- a manual PixInsight load/save smoke test is
# what will empirically settle which API-version floor the resulting .so
# actually declares; nothing here papers over that.
PCL_API_VERSION_HEX=0187

# Compatibility policy: supported floor is PixInsight >= 1.9.4 (this pin's
# PCL_API_Version 0x0187; older cores are untested and unsupported by mpp v1).
